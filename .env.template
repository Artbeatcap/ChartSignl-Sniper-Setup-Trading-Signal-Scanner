# Setup Sniper — Environment Variables
# Copy this to .env and fill in your values

# Required: Polygon.io API key (https://polygon.io/dashboard/api-keys)
MASSIVE_API_KEY=your_massive_api_key_here

# Optional: Discord webhook URL for push alerts
# Create one: Discord Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# Optional: Slack webhook URL for push alerts
# Create one: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Optional: Gmail SMTP email alerts
# Generate an App Password: https://myaccount.google.com/apppasswords
# (requires 2FA enabled on your Google account)
ALERT_EMAIL_FROM=clarencebellwork@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password_here
ALERT_EMAIL_TO=clarencebellwork@gmail.com
ALERT_EMAIL_SENDER_NAME=ChartSignl Alerts

# Optional: FMP (Financial Modeling Prep) for reliable earnings calendar
# Free tier: 250 calls/day. Get key: https://site.financialmodelingprep.com/developer/docs
# If not set, earnings scanner falls back to Polygon/Benzinga (can lag on timing)
FMP_API_KEY=

# Optional: Additional tickers for Phase 2 intraday scanner (Setup 8)
# SPY + QQQ are always included. Phase 1 watchlist tickers auto-included too.
# Add any extras here, comma-separated.
INTRADAY_TICKERS=

# Scan universe size (Polygon snapshot ranked by dollar volume). 500 = liquid core; 1000 = broader.
UNIVERSE_SIZE=500

# Optional: Alpaca news (Benzinga) — Setup 11 news gate. Free Basic / paper key.
# https://docs.alpaca.markets/us/docs/streaming-real-time-news
# News API has been described as free "during the beta period"; verify entitlement.
# Without these keys the scanner still boots; the news gate emits unconfirmed.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# AI Catalyst Briefing (Claude / Anthropic)
# Reuses your existing Anthropic key; no new key needed here.
# The code reads ANTHROPIC_API_KEY from the environment via your shell or host.
# Example (shell, not in this file):
#   export ANTHROPIC_API_KEY=sk-ant-...

# Alert consolidation (noise reduction). Run SHADOW_MODE=true for 3–5 sessions first.
USE_CONSOLIDATOR=false
SHADOW_MODE=true
